      "typeVersion": 2.2,
      "position": [
        1072,
        208
      ],
      "id": "e5b910a7-2078-431a-bd63-c89c4805e0ac",
      "name": "Validar resposta da API"
    },
    {
      "parameters": {
        "jsCode": "const aiData = $input.first().json;\nconst fallbackData = $('Gerar mensagem fallback').first().json;\n\nlet message = fallbackData.message_fallback;\n\ntry {\n  const output = aiData.output;\n\n  if (typeof output === 'string' && output.trim()) {\n    const cleaned = output\n      .replace(/```json/g, '')\n      .replace(/```/g, '')\n      .trim();\n\n    const parsed = JSON.parse(cleaned);\n\n    if (parsed?.ok === true && typeof parsed.message === 'string' && parsed.message.trim()) {\n      message = parsed.message.trim();\n    }\n  }\n} catch (error) {\n  message = fallbackData.message_fallback;\n}\n\nreturn [\n  {\n    json: {\n      ...fallbackData,\n      ai_output_raw: aiData.output,\n      message_final: message\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
        112
      ],
      "id": "d6761797-5ad6-41cd-8fd8-f9ec2a22c490",
      "name": "Sanitizar resposta final"
    },
    {
      "parameters": {
        "chatId": "={{$node[\"Preparar entrada\"].json[\"chat_id\"]}}",
        "text": "={{$json.message_final}}",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2096,
        112
      ],
      "id": "c80abd54-996d-48ac-97db-9e88b567ec4f",
      "name": "Enviar previsão ao usuário",
      "webhookId": "5321a45b-3391-4fb3-b44f-2f547b0c6218",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Token Telegram Chatbot Clima"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Preparar entrada').item.json.chat_id }}",
        "text": "❌ Cidade não encontrada. Use o formato Cidade,UF,BR (ex.: São Paulo,SP,BR).",
