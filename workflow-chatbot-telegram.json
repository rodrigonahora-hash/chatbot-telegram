{
  "name": "workflow-chatbot-telegram",
  "nodes": [
    {
      "parameters": {
        "content": "```\nChatbot Telegram com OpenWeather + IA Generativa para consulta climática em cidades brasileiras.\n```",
        "height": 656,
        "width": 2208,
        "color": 7
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        112,
        -96
      ],
      "id": "431377b5-787a-4426-b410-92d6539d6d97",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        176,
        208
      ],
      "id": "d287e900-85e4-4db2-bfc8-700ee9122932",
      "name": "Telegram Trigger",
      "webhookId": "e87b96fe-c754-455d-b3f8-24946f2e2cca",
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Token Telegram Chatbot Clima"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "//Obter valores resposta\nconst data = $input.first().json;\n\nconst cidade = data.cidade;\nconst temperatura = data.temperatura;\nconst emoji = data.emoji;\nconst condicao_climatica = data.condicao_climatica;\n\nreturn [\n  {\n    json: {\n      ...data,\n      ok: true,\n      message_fallback: `${emoji} A temperatura em ${cidade} é de ${temperatura}°C, ${condicao_climatica}.`\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1296,
        112
      ],
      "id": "1e45c6a3-b6d8-4628-afc7-ce52a8f915ed",
      "name": "Gerar mensagem fallback"
    },
    {
      "parameters": {
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1600,
        336
      ],
      "id": "e17d39c6-bc44-4024-ab88-2da14f26bffb",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e641b314-f976-49ed-98d7-a5bcd3987fe0",
              "name": "queue",
              "value": "={{\n  $json.message.text\n    .trim()\n    .normalize(\"NFD\")\n    .replace(/[\\u0300-\\u036f]/g, \"\")\n    .replace(/\\s*,\\s*/g, \",\")\n    .toLowerCase() + \",br\"\n}}",
              "type": "string"
            },
            {
              "id": "ce7a1ef2-7ec1-46aa-80a7-f846976068a6",
              "name": "chat_id",
              "value": "={{$json.message.chat.id}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        208
      ],
      "id": "36057b0e-5f55-41f2-945c-7458e6f8459e",
      "name": "Preparar entrada"
    },
    {
      "parameters": {
        "url": "https://api.openweathermap.org/data/2.5/weather",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.queue }}"
            },
            {
              "name": "units",
              "value": "metric"
            },
            {
              "name": "lang",
              "value": "pt_br"
            },
            {
              "name": "appid",
              "value": ""
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        624,
        208
      ],
      "id": "20a0e797-fcea-4db1-9e84-a079f0122c64",
      "name": "Consultar clima OpenWeather",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d0b061d2-03c0-489a-9880-79c7661413b6",
              "name": "status_ok",
              "value": "={{ $json.cod === 200 }}",
              "type": "boolean"
            },
            {
              "id": "17ebd5ac-0487-47f9-9523-7ed8e60c29f7",
              "name": "tem_campos_esperados",
              "value": "={{ !!($json.name && $json.main && typeof $json.main.temp === \"number\" && $json.weather && $json.weather[0]) }}",
              "type": "boolean"
            },
            {
              "id": "eb601862-53e9-4ac1-ae05-c50b5ef1fc62",
              "name": "temperatura",
              "value": "={{ Math.round($json.main.temp) }}",
              "type": "string"
            },
            {
              "id": "ea9712a8-961a-4541-af2b-09bcaa769bcc",
              "name": "cidade",
              "value": "={{ $json.name }}",
              "type": "string"
            },
            {
              "id": "5af2290a-76b3-4639-a0e8-f91011c8995f",
              "name": "condicao_climatica",
              "value": "={{ $json.weather[0].description }}",
              "type": "string"
            },
            {
              "id": "5ffd4b13-6281-41aa-a127-9ffb0697458a",
              "name": "emoji",
              "value": "={{   $json.weather[0].main === \"Clear\" ? \"☀️\" :   $json.weather[0].main === \"Clouds\" ? \"☁️\" :   $json.weather[0].main === \"Rain\" ? \"🌧️\" :   $json.weather[0].main === \"Drizzle\" ? \"🌦️\" :   $json.weather[0].main === \"Thunderstorm\" ? \"⛈️\" :   $json.weather[0].main === \"Snow\" ? \"❄️\" :   $json.weather[0].main === \"Mist\" ? \"🌫️\" :   $json.weather[0].main === \"Fog\" ? \"🌫️\" :   \"🌤️\" }}",
              "type": "string"
            },
            {
              "id": "cdee9e58-5342-4b8e-8ef8-d8e87bb578f1",
              "name": "weather",
              "value": "={{ $json.weather[0].main }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        848,
        208
      ],
      "id": "c9f226f2-fb96-4ad2-9e4b-4f2ccd666528",
      "name": "Extrair dados climáticos"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "7a66c25a-a502-4af9-9abf-a20887022ca1",
              "leftValue": "={{ $json.status_ok }}",
              "rightValue": {},
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            },
            {
              "id": "6ce75f77-d5d3-4c3d-ac00-29b4681dffe3",
              "leftValue": "={{ $json.tem_campos_esperados }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
